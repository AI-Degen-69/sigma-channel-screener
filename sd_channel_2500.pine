//@version=5
// ============================================================
// 2500-day Standard Deviation Channel — exact screener match
// Paste into TradingView: Pine Editor (bottom panel) -> paste ->
// "Add to chart". USE ON THE DAILY TIMEFRAME.
// Math mirrors rolling_channel() in monthly_screener.py:
//   OLS regression over the last LEN closes (x = 0..LEN-1),
//   mid = fitted value at the latest bar,
//   sd  = POPULATION stdev of residuals (divide by LEN, not LEN-1),
//   low3/low4 = mid - 3*sd / mid - 4*sd, slope = regression slope.
// NOTE: the screener runs on Yahoo ADJ-CLOSE (split- AND dividend-
// adjusted = total return). TradingView `close` is split-adjusted
// but NOT dividend-adjusted, so on dividend payers the bands sit a
// touch lower than the screener's. Non-payers match to the pixel.
// ============================================================
indicator("σ Channel 2500 (screener match)", shorttitle="σ2500",
     overlay=true, max_bars_back=5000)

LEN        = input.int(2500, "Length (daily bars)", minval=100, maxval=5000)
SRC        = input.source(close, "Source")
SHOW_UPPER = input.bool(true, "Show +3/+4 bands")
SHOW_SIG   = input.bool(true, "Show -3/-4 touch markers")
SHOW_LBL   = input.bool(true, "Show live σ readout")

// Closed-form OLS constants (identical to the Python version)
Sx    = LEN * (LEN - 1) / 2.0
Sxx   = (LEN - 1.0) * LEN * (2.0 * LEN - 1.0) / 6.0
denom = LEN * Sxx - Sx * Sx

// Window sums. Sxy (sum of x*y with x = 0..LEN-1 inside the window)
// is recovered from cumulative sums so no 2500-iteration loop is needed.
Sy    = math.sum(SRC, LEN)
Syy   = math.sum(SRC * SRC, LEN)
cumC  = ta.cum(SRC)
cumXY = ta.cum(bar_index * SRC)
sumY  = cumC - cumC[LEN]
sumTY = cumXY - cumXY[LEN]
Sxy   = sumTY - (bar_index - LEN + 1) * sumY

b   = (LEN * Sxy - Sx * Sy) / denom          // slope ($/day)
a   = (Sy - b * Sx) / LEN                    // intercept
mid = a + b * (LEN - 1)                      // fitted value today
sd  = math.sqrt(math.max((Syy - a * Sy - b * Sxy) / LEN, 0.0))

low3 = mid - 3 * sd
low4 = mid - 4 * sd
up3  = mid + 3 * sd
up4  = mid + 4 * sd
up   = b > 0
pos  = (SRC - mid) / sd                      // current position in σ
ok   = bar_index >= LEN - 1 and sd > 0 and not na(SRC[1])

plot(ok ? mid : na, "mid-line (take-profit)", up ? color.new(#58a6ff, 0) : color.red, 2)
plot(ok ? low3 : na, "-3σ (buy S-tier)", color.new(#3fb950, 0), 2)
plot(ok ? low4 : na, "-4σ (buy others)", color.new(#d29922, 0), 2)
plot(ok and SHOW_UPPER ? up3 : na, "+3σ", color.new(color.gray, 40), 1)
plot(ok and SHOW_UPPER ? up4 : na, "+4σ", color.new(color.gray, 40), 1)

plotshape(ok and SHOW_SIG and ta.crossunder(SRC, low3) and up,
     "-3 touch", shape.triangleup, location.belowbar, color.new(#3fb950, 0), size.small, "-3")
plotshape(ok and SHOW_SIG and ta.crossunder(SRC, low4) and up,
     "-4 touch", shape.triangleup, location.belowbar, color.new(#d29922, 0), size.small, "-4")

var label info = na
if barstate.islast and ok and SHOW_LBL
    txt = "pos " + (pos >= 0 ? "+" : "") + str.tostring(pos, "#.##") + " σ\n" +
         "slope " + (up ? "up" : "FLAT/DOWN") + "\n" +
         "-3/-4>0 " + (low3 > 0 and low4 > 0 ? "yes" : "NO")
    if na(info)
        info := label.new(bar_index, low4, txt, style=label.style_label_up,
             color=color.new(#161b22, 0), textcolor=color.new(#e6e9ee, 0), size=size.small)
    else
        label.set_xy(info, bar_index, low4)
        label.set_text(info, txt)
